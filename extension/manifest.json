{
  "manifest_version": 3,
  "name": "Dongo Adblocker",
  "short_name": "Dongo",
  "version": "1.1.0",
  "description": "Block selected advertising requests and optionally blur Gmail messages on your screen",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequest", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dongo controls",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon_16x16.png",
      "48": "icons/icon_48x48.png",
      "128": "icons/icon_128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail/privacy.js"],
      "css": ["gmail/privacy.css"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dongo_ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon_16x16.png",
    "48": "icons/icon_48x48.png",
    "128": "icons/icon_128x128.png"
  }
}
